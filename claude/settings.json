{
  "permissions": {
    "allow": [
      "Read(/*)",
      "Glob",
      "Grep",
      "WebSearch",
      "WebFetch",
      "Bash(* --version)",
      "Bash(* --help *)",
      "Bash(echo \"EXIT:$?\")",
      "Bash(wait *)",
      "Bash(git status *)",
      "Bash(git show *)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(git fetch *)",
      "Bash(git merge-tree *)",
      "Bash(git ls-tree *)",
      "Bash(git status *)",
      "Bash(git show *)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(git fetch *)",
      "Bash(git merge-tree *)",
      "Bash(git ls-tree *)",
      "Bash(git stash *)",
      "Bash(gh search *)",
      "Bash(gh repo list *)",
      "Bash(gh repo view *)",
      "Bash(gh issue list *)",
      "Bash(gh issue view *)",
      "Bash(gh issue status *)",
      "Bash(gh pr list *)",
      "Bash(gh pr view *)",
      "Bash(gh pr status *)",
      "Bash(gh pr diff *)",
      "mcp__parsable-dev-mcp__*",
      "mcp__atlassian__*"
    ]
  },
  "model": "opus",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash ~/.claude/hooks/session-start.sh"
          }
        ]
      }
    ],
    "Notification": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "afplay /System/Library/Sounds/Glass.aiff"
          }
        ]
      }
    ]
  },
  "modelSettings": {
    "claude-opus-5-5": {
      "effortLevel": "medium"
    },
    "claude-sonnet-5-5": {
      "effortLevel": "high"
    }
  },
  "theme": "dark-ansi"
}
